<Window x:Class="HARAnalyzer_V3.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HAR Analyzer V3"
        Height="850"
        Width="1450"
        MinHeight="650"
        MinWidth="1000"
        WindowStartupLocation="CenterScreen">

    <Grid>

        <!-- ===================================================== -->
        <!-- MAIN ROWS                                             -->
        <!-- ===================================================== -->

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===================================================== -->
        <!-- TOP TOOLBAR                                           -->
        <!-- ===================================================== -->

        <Border Grid.Row="0"
                Background="#F3F3F3"
                BorderBrush="#D0D0D0"
                BorderThickness="0,0,0,1"
                Padding="9">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- ================================================= -->
                <!-- BUTTONS                                           -->
                <!-- ================================================= -->

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal">

                    <Button x:Name="OpenHarButton"
                            Content="Open HAR"
                            Width="100"
                            Height="32"
                            Margin="0,0,10,0"
                            ToolTip="Open a HAR file"
                            Click="OpenHar_Click"/>

                    <Button x:Name="ConvertSazButton"
                            Content="SAZ → HAR"
                            Width="110"
                            Height="32"
                            Margin="0,0,10,0"
                            ToolTip="Convert a Fiddler SAZ file to HAR"
                            Click="ConvertSaz_Click"/>

                    <Button x:Name="ZipHarButton"
                            Content="Zip HAR"
                            Width="100"
                            Height="32"
                            Margin="0,0,10,0"
                            ToolTip="Compress the current HAR file to ZIP"
                            Click="ZipHar_Click"/>

                    <Button x:Name="AboutButton"
                            Content="About"
                            Width="100"
                            Height="32"
                            ToolTip="About HAR Analyzer V3"
                            Click="About_Click"/>

                </StackPanel>

                <!-- ================================================= -->
                <!-- SEARCH                                            -->
                <!-- ================================================= -->

                <TextBox x:Name="SearchBox"
                         Grid.Column="2"
                         Height="32"
                         Margin="0,0,8,0"
                         Padding="6,4"
                         VerticalContentAlignment="Center"
                         ToolTip="Search URL / Host / Method / Status"
                         TextChanged="SearchBox_TextChanged"/>

                <!-- ================================================= -->
                <!-- CLEAR SEARCH                                      -->
                <!-- ================================================= -->

                <Button x:Name="ClearSearchButton"
                        Grid.Column="3"
                        Content="X"
                        Width="32"
                        Height="32"
                        Margin="0,0,10,0"
                        ToolTip="Clear search"
                        Click="ClearSearch_Click"/>

                <!-- ================================================= -->
                <!-- SEARCH LABEL                                      -->
                <!-- ================================================= -->

                <TextBlock Grid.Column="4"
                           Text="Search URL / Host / Method / Status"
                           VerticalAlignment="Center"
                           Foreground="#555555"
                           Margin="0,0,2,0"/>

            </Grid>

        </Border>

        <!-- ===================================================== -->
        <!-- MAIN CONTENT                                          -->
        <!-- ===================================================== -->

        <Grid Grid.Row="1"
              Margin="10">

            <Grid.RowDefinitions>
                <RowDefinition Height="3*"/>
                <RowDefinition Height="6"/>
                <RowDefinition Height="2*"/>
            </Grid.RowDefinitions>

            <!-- ================================================= -->
            <!-- HAR SESSION LIST                                  -->
            <!-- ================================================= -->

            <DataGrid x:Name="HarGrid"
                      Grid.Row="0"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserReorderColumns="True"
                      CanUserResizeColumns="True"
                      CanUserSortColumns="True"
                      SelectionMode="Extended"
                      SelectionUnit="FullRow"
                      GridLinesVisibility="Horizontal"
                      AlternatingRowBackground="#FAFAFA"
                      SelectionChanged="HarGrid_SelectionChanged">

                <DataGrid.Columns>

                    <!-- Frame / Session number -->

                    <DataGridTextColumn Header="#"
                                        Binding="{Binding FrameNumber}"
                                        Width="55"/>

                    <!-- HTTP status -->

                    <DataGridTextColumn Header="Result"
                                        Binding="{Binding Status}"
                                        Width="70"/>

                    <!-- HTTP method -->

                    <DataGridTextColumn Header="Method"
                                        Binding="{Binding Method}"
                                        Width="80"/>

                    <!-- HTTP protocol -->

                    <DataGridTextColumn Header="Protocol"
                                        Binding="{Binding Protocol}"
                                        Width="90"/>

                    <!-- Host -->

                    <DataGridTextColumn Header="Host"
                                        Binding="{Binding Host}"
                                        Width="220"/>

                    <!-- Full URL -->

                    <DataGridTextColumn Header="URL"
                                        Binding="{Binding Url}"
                                        Width="*"/>

                    <!-- Response body size -->

                    <DataGridTextColumn Header="Body"
                                        Binding="{Binding BodySize}"
                                        Width="100"/>

                    <!-- MIME type -->

                    <DataGridTextColumn Header="Content-Type"
                                        Binding="{Binding ContentType}"
                                        Width="180"/>

                    <!-- Request duration -->

                    <DataGridTextColumn Header="Time"
                                        Binding="{Binding Time}"
                                        Width="90"/>

                </DataGrid.Columns>

            </DataGrid>

            <!-- ================================================= -->
            <!-- HORIZONTAL SPLITTER                               -->
            <!-- ================================================= -->

            <GridSplitter Grid.Row="1"
                          Height="6"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="#CCCCCC"
                          ResizeDirection="Rows"
                          ResizeBehavior="PreviousAndNext"/>

            <!-- ================================================= -->
            <!-- SESSION DETAILS                                   -->
            <!-- ================================================= -->

            <TabControl Grid.Row="2">

                <!-- ================================================= -->
                <!-- REQUEST TAB                                       -->
                <!-- ================================================= -->

                <TabItem Header="Request">

                    <TextBox x:Name="RequestText"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             AcceptsTab="True"
                             TextWrapping="NoWrap"
                             FontFamily="Consolas"
                             FontSize="13"
                             Background="White"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"/>

                </TabItem>

                <!-- ================================================= -->
                <!-- RESPONSE TAB                                      -->
                <!-- ================================================= -->

                <TabItem Header="Response">

                    <TextBox x:Name="ResponseText"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             AcceptsTab="True"
                             TextWrapping="NoWrap"
                             FontFamily="Consolas"
                             FontSize="13"
                             Background="White"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"/>

                </TabItem>

                <!-- ================================================= -->
                <!-- BODY TAB                                          -->
                <!-- ================================================= -->

                <TabItem Header="Body">

                    <TextBox x:Name="BodyText"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             AcceptsTab="True"
                             TextWrapping="NoWrap"
                             FontFamily="Consolas"
                             FontSize="13"
                             Background="White"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"/>

                </TabItem>

                <!-- ================================================= -->
                <!-- STATISTICS TAB                                    -->
                <!-- ================================================= -->

                <TabItem Header="Statistics">

                    <TextBox x:Name="StatisticsText"
                             Margin="5"
                             BorderThickness="0"
                             Background="White"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             AcceptsTab="True"
                             TextWrapping="NoWrap"
                             FontFamily="Consolas"
                             FontSize="13"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"/>

                </TabItem>

                <!-- ================================================= -->
                <!-- TIMELINE TAB                                      -->
                <!-- ================================================= -->

                <TabItem Header="Timeline">

                    <Grid Background="White">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="40"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- ========================================= -->
                        <!-- TIMELINE HEADER                           -->
                        <!-- ========================================= -->

                        <Border Grid.Row="0"
                                Background="#F7F7F7"
                                BorderBrush="#CCCCCC"
                                BorderThickness="0,0,0,1">

                            <Grid Margin="8,0">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="TimelineTitle"
                                           Grid.Column="0"
                                           Text="Session Timeline"
                                           FontWeight="SemiBold"
                                           FontSize="14"
                                           VerticalAlignment="Center"/>

                                <TextBlock x:Name="TimelineSummary"
                                           Grid.Column="1"
                                           Foreground="#666666"
                                           VerticalAlignment="Center"/>

                            </Grid>

                        </Border>

                        <!-- ========================================= -->
                        <!-- TIMELINE CANVAS                           -->
                        <!-- ========================================= -->

                        <ScrollViewer Grid.Row="1"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto">

                            <Canvas x:Name="TimelineCanvas"
                                    Background="White"
                                    MinHeight="250"
                                    MinWidth="900"
                                    SizeChanged="TimelineCanvas_SizeChanged"/>

                        </ScrollViewer>

                    </Grid>

                </TabItem>

            </TabControl>

        </Grid>

        <!-- ===================================================== -->
        <!-- STATUS BAR                                            -->
        <!-- ===================================================== -->

        <StatusBar Grid.Row="2">

            <!-- Status -->

            <StatusBarItem>

                <TextBlock x:Name="StatusText"
                           Text="Ready"/>

            </StatusBarItem>

            <Separator/>

            <!-- Total frames -->

            <StatusBarItem>

                <TextBlock x:Name="FrameCountText"
                           Text="Frames: 0"/>

            </StatusBarItem>

            <Separator/>

            <!-- Visible / filtered frames -->

            <StatusBarItem>

                <TextBlock x:Name="VisibleFrameCountText"
                           Text="Visible: 0"/>

            </StatusBarItem>

            <Separator/>

            <!-- Selected frame -->

            <StatusBarItem>

                <TextBlock x:Name="SelectedFrameText"
                           Text="Selected: none"/>

            </StatusBarItem>

        </StatusBar>

    </Grid>

</Window>